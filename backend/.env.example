# Port the HTTP + WebSocket server listens on (Render/Railway set this automatically)
PORT=4000

# MongoDB connection string — local or MongoDB Atlas.
# Leave empty to run with in-memory storage (rooms are lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/watch-party

# Secret used to sign login tokens (JWT). Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Only needed if the frontend is hosted on a DIFFERENT origin (comma-separated list),
# e.g. https://my-watch-party.netlify.app
CLIENT_ORIGIN=

# How long (ms) a disconnected user keeps their seat and role before "leaving"
RECONNECT_GRACE_MS=15000
